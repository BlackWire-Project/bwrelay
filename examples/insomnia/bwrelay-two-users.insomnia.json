        "mimeType": "application/json",
        "text": "{\n  \"inbox_id\": \"{{ _.bob_inbox_id }}\",\n  \"kind\": \"prekey_message\",\n  \"header\": \"{\\\"sender\\\":\\\"{{ _.alice_username }}\\\",\\\"session_stage\\\":\\\"x3dh_bootstrap\\\",\\\"dh\\\":\\\"alice-ephemeral-dh-public-local\\\"}\",\n  \"ciphertext\": \"ciphertext-from-alice-to-bob-bootstrap-local\",\n  \"used_prekey_id\": \"{{ _.bob_bundle_prekey_id }}\",\n  \"client_message_id\": \"alice-to-bob-bootstrap-001\"\n}"
